# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=CandidateIQ
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-32-char-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=../data
OUTPUT_DIR=../output
UPLOAD_DIR=./uploads
MODEL_CACHE_DIR=./model_cache

# ── ML ────────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
FAISS_NLIST=100
FAISS_NPROBE=10
USE_GPU=false
CUDA_DEVICE=0

# ── Scoring weights — PRD 6-signal model (must sum to 1.0) ───────────────────
WEIGHT_SEMANTIC=0.40
WEIGHT_CAREER=0.20
WEIGHT_SKILL=0.20
WEIGHT_ACTIVITY=0.10
WEIGHT_INTENT=0.05
WEIGHT_EDUCATION=0.05

# ── GNN ───────────────────────────────────────────────────────────────────────
GNN_HIDDEN_DIM=128
GNN_OUTPUT_DIM=64
GNN_EPOCHS=100
GNN_LR=0.01

# ── Redis (optional) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
